// Renovate runs as the Mend-hosted GitHub App, which cannot run commands after
// it edits a file. The files derived from the ones it edits (flake.nix's
// pnpmDeps hash, release.yml) are brought back in step by
// .github/workflows/renovate-fixup.yml instead.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', ':semanticCommits'],
  timezone: 'Asia/Tokyo',
  schedule: ['before 9am on monday'],
  // A release that is pulled within days of publishing is the usual shape of a
  // compromised package; waiting costs little on a weekly schedule.
  minimumReleaseAge: '3 days',
  // renovate-fixup.yml commits as this bot. Without this Renovate would treat
  // the branch as hand-edited and stop rebasing and automerging it.
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],

  // release.yml is generated by `dist generate`; dist rejects hand edits.
  // examples/ holds a craber.toml, not a manifest, but stays out on principle.
  ignorePaths: ['**/node_modules/**', '.github/workflows/release.yml', 'examples/**'],

  // Not under .github/workflows/, so not picked up by default. It is the list
  // of steps dist injects into release.yml, and its pins should move with the
  // identical ones in ci.yml.
  'github-actions': {
    managerFilePatterns: ['/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/', '/^\\.github/build-setup\\.yml$/'],
  },
  // flake.lock moves only through lockFileMaintenance; there is nothing in
  // flake.nix to bump.
  nix: {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ['before 9am on the first day of the month'],
  },

  packageRules: [
    // Patch releases merge themselves once CI passes; everything else waits for
    // a person.
    {
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    // The sibling crates are path dependencies whose version literal belongs to
    // `just bump`.
    {
      matchManagers: ['cargo'],
      matchPackageNames: ['craber', 'craber-*'],
      enabled: false,
    },
    // pnpm and Node come from nixpkgs in the flake, and the `packageManager`
    // pin must match the pnpm there (see flake.nix). They move together with a
    // flake.lock update, by hand.
    {
      matchManagers: ['npm'],
      matchDepTypes: ['packageManager', 'engines'],
      enabled: false,
    },
    {
      groupName: 'React',
      matchPackageNames: ['react', 'react-dom', '@types/react', '@types/react-dom'],
    },
    // testcontainers-modules pins one testcontainers minor, so a testcontainers
    // bump on its own does not resolve. Both move once modules has caught up.
    {
      groupName: 'testcontainers',
      matchPackageNames: ['testcontainers', 'testcontainers-modules'],
    },
    {
      groupName: 'Vite',
      matchPackageNames: ['vite', 'vitest', '@vitejs/plugin-react'],
    },
  ],
}
