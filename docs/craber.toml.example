# CrabER project configuration.
#
# Copy to `craber.toml` in your repository root. Every value here can be
# overridden on the command line; CLI flags win over environment variables,
# which win over this file.

# Where the schema comes from. Exactly one of these — and a `--file` or `--dsn`
# on the command line replaces whichever is set here, rather than merging with
# it, so `craber export --dsn ...` connects even in a repository that commits a
# `file` below.
#
# Prefer the CRABER_DSN environment variable to writing a `dsn` here: a
# connection string carries a password and this file is in the repository.
file = "db/schema.sql"
# dsn = "postgres://user@host/db"

# postgres | mysql | sqlite | bigquery. Inferred from the filename, or from a DSN's
# scheme, when omitted — so a `dsn` almost never needs this.
dialect = "postgres"

# Table selection, matched against both `users` and `public.users`.
# `exclude` always wins over `include`, and `depth` never grows past it.
include = ["*"]
exclude = ["schema_migrations", "ar_internal_metadata", "*_audit"]

# Also pull in tables within N foreign-key hops of the included ones.
# depth = 2

# Workflows to play back over the diagram: .sql files, or directories that
# stand for every .sql file beneath them. Relative to this file. `--flow` on
# the command line replaces this list rather than adding to it.
# flows = ["db/flows/"]

# Keys only one command reads live in that command's section, so that one
# command's setting cannot change another's behaviour — a top-level `output`
# would turn `craber export` from stdout into a file the moment this file
# appeared.

[build]
# Directory the site is written to. Relative to this file.
# output = "dist/"
# URL prefix the generated site is served under, e.g. GitHub Pages project
# sites live at /<repo>/.
# base-path = "/myrepo/"

[serve]
# Port to listen on. Defaults to 4300.
# port = 4300

[export]
# json | mermaid | dbml | flows. Defaults to json.
# format = "json"
# File to write. Relative to this file; stdout when omitted.
# output = "schema.json"
